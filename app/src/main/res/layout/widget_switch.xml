<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_switch"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_elite_background"
    android:contentDescription="@string/widget_elite_description">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RADAR VPN"
                android:textColor="#E4FFE9"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ELITE HYBRID  /  TUNNEL INTELLIGENCE"
                android:textColor="#75B88A"
                android:textSize="9sp"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/widget_radar_ring"
            android:contentDescription="@string/widget_radar_indicator">

            <View
                android:layout_width="1dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="#476F55" />

            <View
                android:layout_width="54dp"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:background="#476F55" />

            <View
                android:id="@+id/widget_radar_center_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_signal_dot" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="9dp"
        android:background="#294B35" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/widget_signal_dot" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CHECKING TUNNEL"
            android:textColor="#FFD36A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/widget_rtt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTT  —"
            android:textColor="#A8CDB2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_config_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="CONFIGURATION"
            android:textColor="#E4FFE9"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_config_prev"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#E4FFE9"
            android:textSize="22sp"
            android:background="@drawable/widget_action_background"
            android:contentDescription="Previous configuration" />

        <TextView
            android:id="@+id/widget_config_next"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#E4FFE9"
            android:textSize="22sp"
            android:background="@drawable/widget_action_background"
            android:contentDescription="Next configuration" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:text="Tunnel egress IP: checking…"
        android:textColor="#A8CDB2"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Verifying the Android VPN network"
            android:textColor="#789A82"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_config_next"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="NEXT  ›"
            android:textColor="#B8FFD0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_action_background"
            android:contentDescription="Switch to next VPN configuration" />

        <LinearLayout
            android:id="@+id/widget_action"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:background="@drawable/widget_action_background">

            <ImageView
                android:id="@+id/image_switch"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play_24dp" />

            <TextView
                android:id="@+id/widget_action_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="CONNECT"
                android:textColor="#E4FFE9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
